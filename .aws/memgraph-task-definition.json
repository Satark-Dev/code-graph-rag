{
  "family": "satark-dev-memgraph",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2", "FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::849896204329:role/satarkTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::849896204329:role/satarkTaskExecutionRole",

  "containerDefinitions": [
    {
      "cpu": 0,
      "essential": true,
      "image": "849896204329.dkr.ecr.ap-south-1.amazonaws.com/satark-dev-memgraph:latest",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/satark-dev-memgraph",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "satark-dev-memgraph"
        }
      },
      "mountPoints": [],
      "name": "satark-dev-memgraph",
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "systemControls": [],
      "volumesFrom": []
    }
  ]
}
